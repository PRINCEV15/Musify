generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model User { id String @id @default(cuid()) email String @unique name String? avatarUrl String? artistProfile ArtistProfile? createdAt DateTime @default(now()) }
model ArtistProfile { id String @id @default(cuid()) ownerId String @unique owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade) displayName String username String @unique bio String? location String? country String? genres String[] avatarUrl String? bannerUrl String? website String? contactEmail String? verified Boolean @default(false) monthlyListeners Int @default(0) totalPlays Int @default(0) followers Int @default(0) following Int @default(0) tracks Track[] albums Album[] playlists Playlist[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Track { id String @id @default(cuid()) artistId String artist ArtistProfile @relation(fields:[artistId], references:[id], onDelete: Cascade) title String audioUrl String coverUrl String? duration Int playCount Int @default(0) likeCount Int @default(0) commentCount Int @default(0) repostCount Int @default(0) releaseDate DateTime @default(now()) }
model Album { id String @id @default(cuid()) artistId String artist ArtistProfile @relation(fields:[artistId], references:[id], onDelete: Cascade) title String coverUrl String? releaseDate DateTime? }
model Playlist { id String @id @default(cuid()) artistId String artist ArtistProfile @relation(fields:[artistId], references:[id], onDelete: Cascade) title String description String? coverUrl String? public Boolean @default(true) }
