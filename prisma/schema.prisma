generator client { provider="prisma-client-js" }
datasource db { provider="postgresql" url=env("DATABASE_URL") }
enum Role { LISTENER ARTIST LABEL MODERATOR ADMIN }
enum Visibility { PUBLIC PRIVATE UNLISTED SCHEDULED }
enum ReleaseType { SINGLE EP ALBUM COMPILATION }
enum ReportStatus { SUBMITTED REVIEWING INFO_REQUESTED VALID REJECTED }
model User { id String @id @default(cuid()); email String @unique; username String @unique; passwordHash String?; role Role @default(LISTENER); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; profile Profile?; artist Artist?; likes Like[]; followsOut Follow[] @relation("follower"); followsIn Follow[] @relation("following"); playlists Playlist[]; comments Comment[]; history ListeningEvent[]; notifications Notification[] }
model Profile { id String @id @default(cuid()); userId String @unique; displayName String; bio String?; avatarUrl String?; bannerUrl String?; website String?; location String?; user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model Artist { id String @id @default(cuid()); userId String @unique; stageName String; slug String @unique; verified Boolean @default(false); followersCount Int @default(0); user User @relation(fields:[userId],references:[id],onDelete:Cascade); tracks Track[]; albums Album[] }
model Track { id String @id @default(cuid()); artistId String; albumId String?; title String; slug String @unique; description String?; duration Int; genre String?; releaseDate DateTime?; coverArt String?; audioStatus String @default("PROCESSING"); visibility Visibility @default(PUBLIC); explicit Boolean @default(false); allowDownload Boolean @default(false); allowComments Boolean @default(true); playCount Int @default(0); likeCount Int @default(0); repostCount Int @default(0); commentCount Int @default(0); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; artist Artist @relation(fields:[artistId],references:[id],onDelete:Cascade); album Album? @relation(fields:[albumId],references:[id],onDelete:SetNull); files TrackFile[]; likes Like[]; reposts Repost[]; comments Comment[]; tags TrackTag[]; events ListeningEvent[]; playlistTracks PlaylistTrack[]; reports Report[]; @@index([artistId,createdAt]); @@index([playCount]) }
model TrackFile { id String @id @default(cuid()); trackId String; storageKey String; format String; bitrate Int?; bytes BigInt?; duration Int?; track Track @relation(fields:[trackId],references:[id],onDelete:Cascade); @@index([trackId]) }
model Album { id String @id @default(cuid()); artistId String; title String; slug String @unique; coverArt String?; releaseDate DateTime?; releaseType ReleaseType; description String?; artist Artist @relation(fields:[artistId],references:[id],onDelete:Cascade); tracks Track[] }
model Playlist { id String @id @default(cuid()); ownerId String; title String; description String?; coverArt String?; visibility Visibility @default(PUBLIC); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; owner User @relation(fields:[ownerId],references:[id],onDelete:Cascade); tracks PlaylistTrack[] }
model PlaylistTrack { id String @id @default(cuid()); playlistId String; trackId String; position Int; playlist Playlist @relation(fields:[playlistId],references:[id],onDelete:Cascade); track Track @relation(fields:[trackId],references:[id],onDelete:Cascade); @@unique([playlistId,trackId]); @@index([playlistId,position]) }
model Like { id String @id @default(cuid()); userId String; trackId String; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); track Track @relation(fields:[trackId],references:[id],onDelete:Cascade); @@unique([userId,trackId]) }
model Repost { id String @id @default(cuid()); userId String; trackId String; caption String?; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); track Track @relation(fields:[trackId],references:[id],onDelete:Cascade); @@unique([userId,trackId]) }
model Follow { id String @id @default(cuid()); followerId String; followingId String; createdAt DateTime @default(now()); follower User @relation("follower",fields:[followerId],references:[id],onDelete:Cascade); following User @relation("following",fields:[followingId],references:[id],onDelete:Cascade); @@unique([followerId,followingId]) }
model Comment { id String @id @default(cuid()); userId String; trackId String; parentId String?; body String; timestampMs Int?; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); track Track @relation(fields:[trackId],references:[id],onDelete:Cascade); parent Comment? @relation("replies",fields:[parentId],references:[id],onDelete:NoAction); replies Comment[] @relation("replies"); @@index([trackId,createdAt]) }
model ListeningEvent { id String @id @default(cuid()); userId String?; trackId String; sessionId String; startedAt DateTime @default(now()); endedAt DateTime?; durationPlayed Int @default(0); completionPercentage Float @default(0); device String?; country String?; referrer String?; user User? @relation(fields:[userId],references:[id],onDelete:SetNull); track Track @relation(fields:[trackId],references:[id],onDelete:Cascade); @@index([trackId,startedAt]); @@index([userId,startedAt]) }
model TrackTag { trackId String; tag String; track Track @relation(fields:[trackId],references:[id],onDelete:Cascade); @@id([trackId,tag]) }
model Notification { id String @id @default(cuid()); userId String; type String; payload Json; readAt DateTime?; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId,createdAt]) }
model Report { id String @id @default(cuid()); reporterId String; trackId String?; reason String; details String?; status ReportStatus @default(SUBMITTED); createdAt DateTime @default(now()); reporter User @relation(fields:[reporterId],references:[id],onDelete:Cascade); track Track? @relation(fields:[trackId],references:[id],onDelete:SetNull) }